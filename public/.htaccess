<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route /api/rsvps to PHP endpoint on Hostinger shared hosting
  RewriteRule ^api/rsvps/?$ api/rsvps.php [L,QSA]

  # Do not rewrite existing files, directories, or /api/ routes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^ - [L]

  # SPA fallback for direct visits and browser refreshes on internal routes
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType audio/mpeg .mp3
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
